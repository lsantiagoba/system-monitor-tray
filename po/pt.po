msgid "System Monitor Tray"
msgstr "Monitor do sistema na bandeja"

msgid "Display real-time CPU, memory, swap, and load usage in the top panel"
msgstr "Exibe em tempo real o uso de CPU, memória, swap e carga no painel superior"

msgid "CPU:"
msgstr "CPU:"

msgid "Mem:"
msgstr "Mem:"

