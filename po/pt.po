msgstr "Exibir indicador de uso da swap"

msgid "Show Load"
msgstr "Mostrar carga"

msgid "Display system load indicator"
msgstr "Exibir indicador de carga do sistema"

msgid "Show GPU"
msgstr "Mostrar GPU"

