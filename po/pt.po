msgstr "GPU:"

msgid "System Monitor"
msgstr "Monitor do sistema"

msgid "Appearance Settings"
msgstr "Configurações de aparência"

msgid "Configure how the system monitor appears"
msgstr "Configure a aparência do monitor do sistema"

msgid "Panel Position"
msgstr "Posição no painel"

msgid "Position of the indicator in the top panel"
msgstr "Posição do indicador no painel superior"

msgid "Left"
msgstr "Esquerda"

msgid "Center"
msgstr "Centro"

msgid "Right"
msgstr "Direita"

msgid "Show Icons"
msgstr "Mostrar ícones"

msgid "Display icons instead of text labels"
msgstr "Exibir ícones em vez de rótulos de texto"

msgid "Bold Labels"
msgstr "Rótulos em negrito"

