msgid "Show Swap"
msgstr "Mostrar intercambio"

msgid "Display swap usage indicator"
msgstr "Mostrar el indicador de uso de intercambio"

msgid "Show Load"
msgstr "Mostrar carga"

msgid "Display system load indicator"
msgstr "Mostrar el indicador de carga del sistema"

msgid "Show GPU"
msgstr "Mostrar GPU"

