msgstr "GPU:"

msgid "System Monitor"
msgstr "Monitor del sistema"

msgid "Appearance Settings"
msgstr "Ajustes de apariencia"

msgid "Configure how the system monitor appears"
msgstr "Configura la apariencia del monitor del sistema"

msgid "Panel Position"
msgstr "Posición en el panel"

msgid "Position of the indicator in the top panel"
msgstr "Posición del indicador en el panel superior"

msgid "Left"
msgstr "Izquierda"

msgid "Center"
msgstr "Centro"

msgid "Right"
msgstr "Derecha"

msgid "Show Icons"
msgstr "Mostrar iconos"

msgid "Display icons instead of text labels"
msgstr "Mostrar iconos en lugar de etiquetas de texto"

msgid "Bold Labels"
msgstr "Etiquetas en negrita"

msgid "Display labels in bold text"
